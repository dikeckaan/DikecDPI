cask "dikec-dpi" do
  version "__VERSION__"
  sha256 "__APP_SHA__"

  url "https://github.com/__REPO__/releases/download/v#{version}/DikecDPI-#{version}-macos-universal.zip"
  name "Dikec DPI"
  desc "DPI engellerini aşan, kendi kendini ayarlayan proxy uygulaması"
  homepage "https://github.com/__REPO__"

  depends_on macos: ">= :ventura"

  app "Dikec DPI.app"

  # The app is ad-hoc signed but not notarized; without this macOS refuses
